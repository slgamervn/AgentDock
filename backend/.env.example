AGENTDOCK_SERVICE_NAME=AgentDock API
AGENTDOCK_APP_VERSION=0.2.0
AGENTDOCK_ENVIRONMENT=development

# Use the restricted runtime role for API and worker processes.
AGENTDOCK_DATABASE_URL=postgresql+asyncpg://agentdock_runtime:CHANGE_ME@localhost:5432/agentdock

# Use only for Alembic migrations; never use this role for normal API requests.
AGENTDOCK_MIGRATION_DATABASE_URL=postgresql+asyncpg://agentdock_migrator:CHANGE_ME@localhost:5432/agentdock
